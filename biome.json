{
  "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!node_modules", "!dist", "!.claude", "!coverage", "!package-lock.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "overrides": [
    {
      "includes": [
        "src/entities/logic/**",
        "src/systems/**",
        "src/state/**",
        "src/save/**",
        "src/content/**",
        "src/rng/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "phaser": "Phaser must not be imported in pure-logic dirs (TECHSPEC §4.1)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**", "!src/save/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "localStorage": "Access localStorage only through src/save/ (TECHSPEC §6.4).",
                  "sessionStorage": "Access sessionStorage only through src/save/ (TECHSPEC §6.4)."
                }
              }
            }
          }
        }
      }
    }
  ]
}
